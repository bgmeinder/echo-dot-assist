+/* Access points that refuse us (the Echo Spot): Fire OS's wpa_supplicant picks the strongest access point of a network
+ * every time ("adptClntPickBss"), its own blacklist aside, so one that refuses (a router locking the Echo to another
+ * access point: Open System authentication rejected, or no answer) held the Echo off the network while another of the
+ * same network would answer, and Android switched the network off after a few failures (2026-11-08, 2026-11-19).
+ * A connect that fails before the link comes up (authentication or association; a wrong password fails later, in the
+ * 4-way handshake, and counts nothing) marks that BSSID for WL_REFUSE_WINDOW s, and every further failure while it is
+ * marked extends that to WL_REFUSE_WINDOW s from then.  While marked it is left out of the scan results, and out of
+ * cfg80211's cache at once, whenever another access point of the same network was in a scan within
+ * WL_REFUSE_ALT_FRESH s: the supplicant takes that one.  When it is the only one, it is offered again after a backoff,
+ * 1 s after the first failure and doubling with each one (2, 4, 8 ... s, at most WL_REFUSE_HOLD_MAX s).  A connect
+ * to it that works clears the mark; so does a window that runs out without a failure, and the backoff starts over.
+ */
+#define WL_REFUSE_MAX		8
+#define WL_REFUSE_HOLD		1
+#define WL_REFUSE_HOLD_MAX	300
+#define WL_REFUSE_WINDOW	60
+#define WL_REFUSE_ALT_FRESH	30
+static struct wl_refuser {
+	u8 bssid[ETH_ALEN];
+	u8 ssid[DOT11_MAX_SSID_LEN];
+	u32 ssid_len;			/* its network's name, from the connect or a scan (0: not known yet) */
+	u32 fails;			/* failures in a row within the window (0: a free entry) */
+	unsigned long until;		/* jiffies: the end of the window */
+	unsigned long retry;		/* jiffies: the end of the backoff */
+	unsigned long alt;		/* jiffies: another access point of its network last seen (0: never) */
+} wl_refusers[WL_REFUSE_MAX];
+static DEFINE_SPINLOCK(wl_refusers_lock);
+
+/* the marked entry of this BSSID, or NULL; one whose window ran out is freed.  Under wl_refusers_lock */
+static struct wl_refuser *
+wl_refuser_find(const u8 *bssid)
+{
+	int i;
+	for (i = 0; i < WL_REFUSE_MAX; i++) {
+		struct wl_refuser *r = &wl_refusers[i];
+		if (!r->fails)
+			continue;
+		if (!time_before(jiffies, r->until)) {
+			memset(r, 0, sizeof(*r));
+			continue;
+		}
+		if (!memcmp(r->bssid, bssid, ETH_ALEN))
+			return r;
+	}
+	return NULL;
+}
+
+/* one access point of a scan: a marked one learns its network's name; any other that is not marked itself counts as
+ * another access point of the networks of the marked ones with that name.  Under wl_refusers_lock */
+static void
+wl_refuser_note_locked(wl_bss_info_v109_t *bi)
+{
+	const u8 *bssid = (const u8 *)&bi->BSSID;
+	u32 len = bi->SSID_len;
+	struct wl_refuser *self;
+	int i;
+
+	if (!len || len > DOT11_MAX_SSID_LEN)
+		return;
+	self = wl_refuser_find(bssid);
+	if (self) {
+		memcpy(self->ssid, bi->SSID, len);
+		self->ssid_len = len;
+		return;
+	}
+	for (i = 0; i < WL_REFUSE_MAX; i++) {
+		struct wl_refuser *r = &wl_refusers[i];
+		if (r->fails && r->ssid_len == len && !memcmp(r->ssid, bi->SSID, len)) {
+			r->alt = jiffies;
+			if (!r->alt)
+				r->alt = 1;
+		}
+	}
+}
+
+/* a whole scan, before its results go up: so that a marked access point listed before the other one of its network is
+ * already known to have one (two passes: the names first) */
+static void
+wl_refuser_note_list(wl_scan_results_v109_t *bss_list)
+{
+	wl_bss_info_v109_t *bi;
+	unsigned long flags;
+	s32 i, pass;
+
+	if (!bss_list || !bss_list->count)
+		return;
+	spin_lock_irqsave(&wl_refusers_lock, flags);
+	for (pass = 0; pass < 2; pass++) {
+		bi = NULL;
+		bi = next_bss(bss_list, bi);
+		for_each_bss(bss_list, bi, i)
+			wl_refuser_note_locked(bi);
+	}
+	spin_unlock_irqrestore(&wl_refusers_lock, flags);
+}
+
+/* whether this access point is left out of the scan results now (noting it first, for the results that come up one
+ * at a time) */
+static bool
+wl_refuser_hidden(wl_bss_info_v109_t *bi)
+{
+	struct wl_refuser *r;
+	unsigned long flags;
+	bool hidden = false;
+
+	spin_lock_irqsave(&wl_refusers_lock, flags);
+	wl_refuser_note_locked(bi);
+	r = wl_refuser_find((const u8 *)&bi->BSSID);
+	if (r && (time_before(jiffies, r->retry) ||
+			(r->alt && time_before(jiffies, r->alt + WL_REFUSE_ALT_FRESH * HZ))))
+		hidden = true;
+	spin_unlock_irqrestore(&wl_refusers_lock, flags);
+	return hidden;
+}
+
+/* the result of a connect to bssid: ok, or failed before the link came up */
+void
+wl_refuser_result(struct bcm_cfg80211 *cfg, struct net_device *ndev, const u8 *bssid, bool ok)
+{
+	struct wl_refuser *r;
+	struct cfg80211_bss *bss;
+	wlc_ssid_t *ssid;
+	unsigned long flags;
+	u32 hold, fails;
+	int i;
+
+	if (!bssid || ETHER_ISNULLADDR(bssid) || ETHER_ISBCAST(bssid))
+		return;
+	ssid = (wlc_ssid_t *)wl_read_prof(cfg, ndev, WL_PROF_SSID);
+	spin_lock_irqsave(&wl_refusers_lock, flags);
+	r = wl_refuser_find(bssid);
+	if (ok) {
+		if (r)
+			memset(r, 0, sizeof(*r));
+		spin_unlock_irqrestore(&wl_refusers_lock, flags);
+		return;
+	}
+	if (!r) {
+		/* a free entry, else the one whose window ends first */
+		r = &wl_refusers[0];
+		for (i = 0; i < WL_REFUSE_MAX; i++) {
+			if (!wl_refusers[i].fails) {
+				r = &wl_refusers[i];
+				break;
+			}
+			if (time_before(wl_refusers[i].until, r->until))
+				r = &wl_refusers[i];
+		}
+		memset(r, 0, sizeof(*r));
+		memcpy(r->bssid, bssid, ETH_ALEN);
+	}
+	if (ssid && ssid->SSID_len && ssid->SSID_len <= DOT11_MAX_SSID_LEN) {
+		memcpy(r->ssid, ssid->SSID, ssid->SSID_len);
+		r->ssid_len = ssid->SSID_len;
+	}
+	r->fails++;
+	fails = r->fails;
+	hold = WL_REFUSE_HOLD;
+	for (i = 1; i < (int)fails && hold < WL_REFUSE_HOLD_MAX; i++)
+		hold *= 2;
+	if (hold > WL_REFUSE_HOLD_MAX)
+		hold = WL_REFUSE_HOLD_MAX;
+	r->retry = jiffies + hold * HZ;
+	r->until = jiffies + WL_REFUSE_WINDOW * HZ;
+	if (!r->until)
+		r->until = 1;
+	spin_unlock_irqrestore(&wl_refusers_lock, flags);
+	WL_MSG(ndev->name, "%pM refused %u connects in a row: skipped for %u s while another access point has "
+		"its network, else retried in %u s\n", bssid, fails, WL_REFUSE_WINDOW, hold);
+	/* out of cfg80211's cache too, or the supplicant's next pick finds it there (kept 30 s) */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4, 1, 0))
+	bss = cfg80211_get_bss(bcmcfg_to_wiphy(cfg), NULL, bssid, NULL, 0,
+		IEEE80211_BSS_TYPE_ANY, IEEE80211_PRIVACY_ANY);
+#else
+	bss = cfg80211_get_bss(bcmcfg_to_wiphy(cfg), NULL, bssid, NULL, 0,
+		WLAN_CAPABILITY_ESS, WLAN_CAPABILITY_ESS);
+#endif
+	if (bss) {
+		cfg80211_unlink_bss(bcmcfg_to_wiphy(cfg), bss);
+		CFG80211_PUT_BSS(bcmcfg_to_wiphy(cfg), bss);
+	}
+}
